{
  "manifest_version": 3,
  "name": "HLS Deck Köprüsü",
  "version": "1.0.0",
  "description": "Sayfalardaki m3u8 isteklerini header'larıyla yakalayıp HLS Deck masaüstü uygulamasına aktarır.",
  "permissions": [
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "HLS Deck",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "homepage_url": "https://github.com/yusuf-polat/hls-deck"
}
